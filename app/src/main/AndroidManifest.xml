<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".Creador360App"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Creador360 PRO"
        android:theme="@style/Theme.Creador360"
        android:supportsRtl="true">

        <!-- Splash Screen como launcher -->
        <activity
            android:name=".ui.splash.SplashScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.Creador360.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MainActivity ya no es launcher -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ui.editor.DesignEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.editor.VideoEditorActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".ui.teleprompter.TeleprompterActivity" android:exported="false" />
        <activity android:name=".ui.audio.AudioEditorActivity" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
