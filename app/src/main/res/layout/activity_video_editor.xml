<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:text="←"
            android:textSize="16sp"
            android:backgroundTint="#2A2A2A"
            android:minWidth="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editor de Video"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnUndo"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="↩"
            android:backgroundTint="#2A2A2A"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/btnRedo"
            android:layout_width="36dp"
            android:layout_height="32dp"
            android:text="↪"
            android:backgroundTint="#2A2A2A"
            android:minWidth="0dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnExportTop"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:text="Guardar"
            android:textSize="10sp"
            android:backgroundTint="#8B5CF6"
            android:minWidth="0dp"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <!-- Zona de reproducción -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <com.google.android.exoplayer2.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000" />

        <TextView
            android:id="@+id/textOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/stickerOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textSize="48sp"
            android:visibility="gone" />

        <View
            android:id="@+id/filterOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent" />
    </FrameLayout>

    <!-- Timeline y controles -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:orientation="vertical">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:scrollbars="none"
            android:padding="4dp">

            <LinearLayout
                android:id="@+id/llTimeline"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical" />
        </HorizontalScrollView>

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="8dp"
            android:progressTint="#8B5CF6"
            android:thumbTint="#FFFFFF" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnAddClip"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="+ Clip"
                android:textSize="11sp"
                android:backgroundTint="#2A2A2A"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTransition"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔄 Transición"
                android:textSize="11sp"
                android:backgroundTint="#2A2A2A"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnTrim"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="✂️ Recortar"
                android:textSize="11sp"
                android:backgroundTint="#2A2A2A"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnSpeed"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="⚡ Veloc."
                android:textSize="11sp"
                android:backgroundTint="#2A2A2A"
                android:layout_marginEnd="4dp" />

            <Button
                android:id="@+id/btnMute"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="🔊"
                android:textSize="11sp"
                android:backgroundTint="#2A2A2A" />
        </LinearLayout>
    </LinearLayout>

    <!-- Pestañas de herramientas -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1A1A1A"
        android:scrollbars="none"
        android:paddingHorizontal="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button android:id="@+id/btnTabCanvas" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🎨 Canvas" android:textSize="11sp" android:backgroundTint="#2A2A2A" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnTabMusic" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🎵 Música" android:textSize="11sp" android:backgroundTint="#2A2A2A" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnTabText" android:layout_width="wrap_content" android:layout_height="40dp" android:text="📝 Texto" android:textSize="11sp" android:backgroundTint="#2A2A2A" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnTabStickers" android:layout_width="wrap_content" android:layout_height="40dp" android:text="😀 Stickers" android:textSize="11sp" android:backgroundTint="#2A2A2A" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnTabEffects" android:layout_width="wrap_content" android:layout_height="40dp" android:text="✨ Efectos" android:textSize="11sp" android:backgroundTint="#2A2A2A" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnTabFilters" android:layout_width="wrap_content" android:layout_height="40dp" android:text="🎨 Filtros" android:textSize="11sp" android:backgroundTint="#2A2A2A" android:layout_marginEnd="4dp" />
            <Button android:id="@+id/btnTabAdjust" android:layout_width="wrap_content" android:layout_height="40dp" android:text="⚙️ Ajustes" android:textSize="11sp" android:backgroundTint="#2A2A2A" />
        </LinearLayout>
    </HorizontalScrollView>
</LinearLayout>
