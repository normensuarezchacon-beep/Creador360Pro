<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#2A2A2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:text="←"
            android:textSize="16sp"
            android:backgroundTint="#555555"
            android:minWidth="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Editor de Video"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnAddClip"
            android:layout_width="50dp"
            android:layout_height="32dp"
            android:text="+ Clip"
            android:textSize="10sp"
            android:backgroundTint="#8B5CF6"
            android:minWidth="0dp" />
    </LinearLayout>

    <VideoView
        android:id="@+id/videoPreview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="#1A1A1A"
        android:scrollbars="none"
        android:padding="4dp">

        <LinearLayout
            android:id="@+id/llClipThumbnails"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="#2A2A2A"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:text="▶"
            android:textSize="14sp"
            android:backgroundTint="#8B5CF6"
            android:minWidth="0dp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:text="⏸"
            android:textSize="14sp"
            android:backgroundTint="#555555"
            android:minWidth="0dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="50dp"
            android:layout_height="30dp"
            android:text="⏹"
            android:textSize="14sp"
            android:backgroundTint="#555555"
            android:minWidth="0dp"
            android:layout_marginStart="4dp" />

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="8dp" />

        <TextView
            android:id="@+id/tvTime"
            android:layout_width="80dp"
            android:layout_height="wrap_content"
            android:text="00:00 / 00:00"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A2A2A"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnTransition"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🔄 Transición"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnTrim"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="✂️ Cortar"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSpeed"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="⚡ Veloc."
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="🔊"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💾 Exp."
            android:textSize="11sp"
            android:backgroundTint="#8B5CF6" />
    </LinearLayout>
</LinearLayout>
