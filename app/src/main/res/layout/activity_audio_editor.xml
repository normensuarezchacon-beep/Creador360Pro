<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#1A1A1A">

    <!-- Barra superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#2A2A2A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:text="←"
            android:textSize="16sp"
            android:backgroundTint="#555555"
            android:minWidth="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Estudio de Audio"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnList"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:text="📋"
            android:textSize="14sp"
            android:backgroundTint="#8B5CF6"
            android:minWidth="0dp" />
    </LinearLayout>

    <!-- Visualización -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎙️"
            android:textSize="80sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Graba, edita y exporta"
            android:textColor="#FFFFFF"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Formato WAV • Normalización • Fade"
            android:textColor="#888888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Controles de grabación -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A2A2A"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🎤 Grabar"
            android:textSize="14sp"
            android:backgroundTint="#FF0000"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnPause"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="⏸ Pausa"
            android:textSize="14sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="▶ Reproducir"
            android:textSize="14sp"
            android:backgroundTint="#8B5CF6"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnStop"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="⏹ Parar"
            android:textSize="14sp"
            android:backgroundTint="#555555" />
    </LinearLayout>

    <!-- Efectos -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A2A2A"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnNormalize"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="📊 Normalizar"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnFade"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="🔊 Fade"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />
    </LinearLayout>

    <!-- Recorte -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A2A2A"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnTrimStart"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⏱ Marcar inicio"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnTrimEnd"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="⏱ Marcar fin"
            android:textSize="11sp"
            android:backgroundTint="#555555"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnApplyTrim"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="✂️ Aplicar"
            android:textSize="11sp"
            android:backgroundTint="#8B5CF6" />
    </LinearLayout>

    <!-- Exportar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2A2A2A"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp">

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💾 Exportar WAV"
            android:textSize="12sp"
            android:backgroundTint="#8B5CF6" />
    </LinearLayout>
</LinearLayout>
