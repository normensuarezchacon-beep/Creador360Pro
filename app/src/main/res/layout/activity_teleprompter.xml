<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Vista previa de la cámara (oculta por defecto) -->
    <SurfaceView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Capa de texto -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Barra superior -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:text="←"
                android:textSize="16sp"
                android:backgroundTint="#555555"
                android:minWidth="0dp" />

            <TextView
                android:id="@+id/tvCurrentScript"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Teleprompter"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:gravity="center"
                android:visibility="invisible" />

            <Button
                android:id="@+id/btnLoadScript"
                android:layout_width="44dp"
                android:layout_height="32dp"
                android:text="Abrir"
                android:textSize="10sp"
                android:backgroundTint="#8B5CF6"
                android:minWidth="0dp" />

            <Button
                android:id="@+id/btnNewScript"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="+"
                android:textSize="16sp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#8B5CF6"
                android:minWidth="0dp" />

            <Button
                android:id="@+id/btnEditScript"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:text="✏️"
                android:textSize="12sp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#555555"
                android:minWidth="0dp" />

            <Button
                android:id="@+id/btnMirror"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:text="🪞"
                android:textSize="14sp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#555555"
                android:minWidth="0dp" />

            <Button
                android:id="@+id/btnCameraOverlay"
                android:layout_width="40dp"
                android:layout_height="32dp"
                android:text="📷"
                android:textSize="14sp"
                android:layout_marginStart="2dp"
                android:backgroundTint="#555555"
                android:minWidth="0dp" />
        </LinearLayout>

        <!-- Temporizador -->
        <TextView
            android:id="@+id/tvTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:gravity="end"
            android:layout_gravity="end" />

        <!-- Botón reiniciar timer -->
        <Button
            android:id="@+id/btnResetTimer"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="⏱ Reiniciar"
            android:textSize="10sp"
            android:backgroundTint="#555555"
            android:layout_gravity="end"
            android:layout_marginTop="4dp" />

        <!-- Área de texto desplazable -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvScript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selecciona un guión o crea uno nuevo para empezar."
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:lineSpacingExtra="8dp"
                android:gravity="center" />
        </ScrollView>

        <!-- Controles inferiores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSpeedDown"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="−"
                    android:textSize="14sp"
                    android:backgroundTint="#555555"
                    android:minWidth="0dp" />

                <SeekBar
                    android:id="@+id/seekBarSpeed"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp" />

                <Button
                    android:id="@+id/btnSpeedUp"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="+"
                    android:textSize="14sp"
                    android:backgroundTint="#555555"
                    android:minWidth="0dp" />

                <Button
                    android:id="@+id/btnStartStop"
                    android:layout_width="48dp"
                    android:layout_height="32dp"
                    android:text="▶"
                    android:textSize="14sp"
                    android:backgroundTint="#8B5CF6"
                    android:minWidth="0dp"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tamaño:"
                    android:textColor="#888888"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekBarTextSize"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="8dp"
                    android:max="50"
                    android:progress="28" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
