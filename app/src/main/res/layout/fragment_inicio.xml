<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canva_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSaludo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Hola, Creador!"
                    android:textColor="@color/canva_text_primary"
                    android:textSize="28sp"
                    android:fontFamily="@font/grand_hotel"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¿Qué creamos hoy?"
                    android:textColor="@color/canva_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_avatar_bg"
                android:contentDescription="Avatar"
                android:padding="10dp"
                android:src="@drawable/ic_person" />
        </LinearLayout>

        <!-- Barra de búsqueda -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="26dp"
            app:cardElevation="2dp"
            android:background="@color/canva_surface">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_search" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Buscar ideas, plantillas..."
                    android:textColor="@color/canva_text_hint"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Título de sección -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Crear nuevo"
            android:textColor="@color/canva_text_primary"
            android:textSize="18sp"
            android:fontFamily="@font/poppins"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Grid de acciones (2x3) -->
        <GridLayout
            android:id="@+id/gridAcciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:rowCount="2"
            android:layout_marginBottom="20dp">

            <!-- Diseño -->
            <LinearLayout
                android:id="@+id/btnDiseno"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/action_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="3dp">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_design"
                    android:contentDescription="Diseño" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Diseño"
                    android:textColor="@color/canva_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Video -->
            <LinearLayout
                android:id="@+id/btnVideo"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/action_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="3dp">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_video"
                    android:contentDescription="Video" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Video"
                    android:textColor="@color/canva_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Audio -->
            <LinearLayout
                android:id="@+id/btnAudio"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/action_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="3dp">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_mic"
                    android:contentDescription="Audio" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Audio"
                    android:textColor="@color/canva_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Guión -->
            <LinearLayout
                android:id="@+id/btnGuion"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/action_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="3dp">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_script"
                    android:contentDescription="Guión" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Guión"
                    android:textColor="@color/canva_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Teleprompter -->
            <LinearLayout
                android:id="@+id/btnTeleprompter"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/action_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="3dp">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_teleprompter"
                    android:contentDescription="Teleprompter" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Teleprompter"
                    android:textColor="@color/canva_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>

            <!-- Ideas -->
            <LinearLayout
                android:id="@+id/btnIdeas"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_columnWeight="1"
                android:layout_margin="4dp"
                android:background="@drawable/action_card_bg"
                android:gravity="center"
                android:orientation="vertical"
                android:elevation="3dp">
                
                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_lightbulb"
                    android:contentDescription="Ideas" />
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Ideas"
                    android:textColor="@color/canva_text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins" />
            </LinearLayout>
        </GridLayout>

        <!-- Proyectos recientes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Proyectos recientes"
                android:textColor="@color/canva_text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/poppins"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVerTodos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ver todos →"
                android:textColor="@color/canva_purple"
                android:textSize="13sp"
                android:fontFamily="@font/poppins" />
        </LinearLayout>

        <!-- Placeholder proyectos -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/project_card_bg"
                android:padding="24dp"
                android:src="@drawable/ic_add_photo"
                android:scaleType="centerInside" />

            <ImageView
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:background="@drawable/project_card_bg"
                android:padding="24dp"
                android:src="@drawable/ic_add_photo"
                android:scaleType="centerInside" />
        </LinearLayout>

        <!-- Marca de agua -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Creado por invexXo TEAM"
            android:textColor="@color/canva_text_hint"
            android:textSize="11sp"
            android:fontFamily="@font/poppins" />
    </LinearLayout>
</ScrollView>
