<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    android:orientation="vertical">

    <!-- Tarjeta de resumen con gradiente -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_margin="12dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvResumen"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Total: $0 CUP"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingExtra="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ingresos totales convertidos a CUP"
            android:textColor="#E8D5F5"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Botones de acción -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnAgregarIngreso"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="+ Ingreso"
            android:textSize="13sp"
            android:textStyle="bold"
            android:backgroundTint="#8B5CF6"
            android:layout_marginEnd="6dp"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnVerGrafico"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📊 Gráfico"
            android:textSize="13sp"
            android:backgroundTint="#4F46E5"
            android:layout_marginEnd="6dp"
            android:elevation="2dp" />

        <Button
            android:id="@+id/btnExportarCSV"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="📄 CSV"
            android:textSize="13sp"
            android:backgroundTint="#555555"
            android:elevation="2dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnTasaCambio"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:text="💱 Tasas"
            android:textSize="12sp"
            android:backgroundTint="#FF9800"
            android:layout_marginEnd="6dp" />
    </LinearLayout>

    <!-- Lista de ingresos -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Últimos ingresos"
        android:textColor="#333333"
        android:textSize="16sp"
        android:textStyle="bold"
        android:paddingHorizontal="16dp"
        android:paddingBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/llIngresos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="12dp" />
    </ScrollView>
</LinearLayout>
