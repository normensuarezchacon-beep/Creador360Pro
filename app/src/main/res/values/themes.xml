<resources>
    <!-- Tema principal -->
    <style name="Theme.Creador360" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#8B5CF6</item>
        <item name="colorPrimaryVariant">#6D28D9</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#EC4899</item>
        <item name="colorSecondaryVariant">#BE185D</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorSurface">#FFFFFF</item>
        <item name="colorOnSurface">#1F2937</item>
        <item name="android:colorBackground">#F9FAFB</item>
        <item name="android:statusBarColor">#F9FAFB</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="fontFamily">@font/poppins</item>
    </style>

    <!-- Tema para Splash Screen -->
    <style name="Theme.Creador360.Splash" parent="Theme.Creador360">
        <item name="android:windowBackground">@color/canva_bg</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
